{
  "name": "pulsegrid",
  "version": "1.0.0",
  "type": "module",
  "description": "pulsegrid - High-performance Web3 DEX & Circle W3S Engine for Arc Testnet",
  "main": "index.html",
  "scripts": {
    "dev": "next dev --webpack",
    "build:next": "next build --webpack",
    "start": "node server.mjs",
    "create-wallet": "tsx --env-file=.env scripts/create-wallet.ts",
    "send-tokens": "tsx --env-file=.env scripts/send-tokens.ts",
    "send-kit": "tsx --env-file=.env scripts/send-kit.ts",
    "send-circle-wallets": "tsx --env-file=.env scripts/send-circle-wallets.ts",
    "send-ethers": "tsx --env-file=.env scripts/send-ethers.ts",
    "fee-estimator": "tsx --env-file=.env scripts/fee-estimator.ts",
    "supported-chains": "tsx --env-file=.env scripts/supported-chains.ts",
    "unified-balance-chains": "tsx --env-file=.env scripts/unified-balance-chains.ts",
    "chain-filters": "tsx --env-file=.env scripts/chain-filters.ts",
    "bridge-tokens": "tsx --env-file=.env scripts/bridge-tokens.ts",
    "swap-viem": "tsx --env-file=.env scripts/swap-viem.ts",
    "swap-circle-wallets": "tsx --env-file=.env scripts/swap-circle-wallets.ts",
    "balance-checker": "tsx --env-file=.env scripts/balance-checker.ts",
    "custom-rpc-adapter": "tsx --env-file=.env scripts/custom-rpc-adapter.ts",
    "register-entity-secret": "tsx --env-file=.env scripts/register-entity-secret.ts",
    "encrypt-entity-secret": "tsx --env-file=.env scripts/encrypt-entity-secret.ts",
    "get-public-key": "tsx --env-file=.env scripts/get-public-key.ts",
    "build": "echo 'Build complete'"
  },
  "keywords": [
    "arc-testnet",
    "circle-w3s",
    "dex",
    "usdc",
    "eurc"
  ],
  "author": "pulsegrid Ecosystem",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.18",
    "next": "^16.3.0",
    "solc": "^0.8.20",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@circle-fin/adapter-circle-wallets": "^1.6.0",
    "@circle-fin/adapter-viem-v2": "^1.15.0",
    "@circle-fin/app-kit": "^1.12.0",
    "@circle-fin/bridge-kit": "^1.13.0",
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@circle-fin/swap-kit": "^1.5.1",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@tanstack/react-query": "^5.102.8",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.55.13",
    "wagmi": "^2.5.0"
  },
  "overrides": {
    "@solana/codecs-strings": "^2.0.0"
  }
}
