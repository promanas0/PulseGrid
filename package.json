{
  "name": "pulsegrid",
  "version": "1.0.0",
  "type": "module",
  "description": "pulsegrid - High-performance Web3 DEX & Circle W3S Engine for Arc Testnet",
  "main": "index.html",
  "scripts": {
    "dev": "next dev --webpack",
    "build:next": "next build --webpack",
    "start": "node server.mjs",
    "create-wallet": "node --env-file=.env create-wallet.js",
    "send-tokens": "node --env-file=.env send-tokens.js",
    "send-tokens:ts": "tsx --env-file=.env send-tokens.ts",
    "send-kit": "node --env-file=.env send-kit.js",
    "send-kit:ts": "tsx --env-file=.env send-kit.ts",
    "send-circle-wallets": "node --env-file=.env send-circle-wallets.js",
    "send-circle-wallets:ts": "tsx --env-file=.env send-circle-wallets.ts",
    "send-ethers": "node --env-file=.env send-ethers.js",
    "send-ethers:ts": "tsx --env-file=.env send-ethers.ts",
    "fee-estimator": "node --env-file=.env fee-estimator.js",
    "fee-estimator:ts": "tsx --env-file=.env fee-estimator.ts",
    "supported-chains": "node --env-file=.env supported-chains.js",
    "supported-chains:ts": "tsx --env-file=.env supported-chains.ts",
    "unified-balance-chains": "node --env-file=.env unified-balance-chains.js",
    "unified-balance-chains:ts": "tsx --env-file=.env unified-balance-chains.ts",
    "chain-filters": "node --env-file=.env chain-filters.js",
    "chain-filters:ts": "tsx --env-file=.env chain-filters.ts",
    "bridge-tokens": "node --env-file=.env bridge-tokens.js",
    "bridge-tokens:ts": "tsx --env-file=.env bridge-tokens.ts",
    "swap-viem": "node --env-file=.env swap-viem.js",
    "swap-viem:ts": "tsx --env-file=.env swap-viem.ts",
    "swap-circle-wallets": "node --env-file=.env swap-circle-wallets.js",
    "swap-circle-wallets:ts": "tsx --env-file=.env swap-circle-wallets.ts",
    "wagmi-config": "tsx --env-file=.env wagmi-config.ts",
    "wagmi-config:ts": "tsx --env-file=.env wagmi-config.ts",
    "balance-checker": "node --env-file=.env balance-checker.js",
    "balance-checker:ts": "tsx --env-file=.env balance-checker.ts",
    "custom-rpc-adapter": "node --env-file=.env custom-rpc-adapter.js",
    "custom-rpc-adapter:ts": "tsx --env-file=.env custom-rpc-adapter.ts",
    "register-entity-secret": "node --env-file=.env register-entity-secret.js",
    "register-entity-secret:ts": "tsx --env-file=.env register-entity-secret.ts",
    "encrypt-entity-secret": "node --env-file=.env encrypt-entity-secret.js",
    "encrypt-entity-secret:ts": "tsx --env-file=.env encrypt-entity-secret.ts",
    "get-public-key": "node --env-file=.env get-public-key.js",
    "get-public-key:ts": "tsx --env-file=.env get-public-key.ts",
    "server": "node server.mjs",
    "build": "echo 'Build complete'"
  },
  "keywords": [
    "arc-testnet",
    "circle-w3s",
    "dex",
    "usdc",
    "eurc"
  ],
  "author": "pulsegrid Ecosystem",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.18",
    "next": "^16.3.0",
    "solc": "^0.8.20",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@circle-fin/adapter-circle-wallets": "^1.6.0",
    "@circle-fin/adapter-viem-v2": "^1.15.0",
    "@circle-fin/app-kit": "^1.12.0",
    "@circle-fin/bridge-kit": "^1.13.0",
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@circle-fin/swap-kit": "^1.5.1",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.102.8",
    "connectkit": "^1.7.3",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.55.13",
    "wagmi": "^2.5.0"
  },
  "overrides": {
    "@solana/codecs-strings": "^2.0.0"
  }
}
