{
  "outputDirectory": ".",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "echo 'Build complete'",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; object-src 'none';"
        }
      ]
    }
  ]
}
